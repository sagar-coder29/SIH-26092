# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider Configuration
# CHAT: "openai", "anthropic", or "gemini"
# EMBEDDINGS: "openai" or "gemini" (Anthropic has no embedding endpoint)
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Gemini Configuration (default provider -- paste your Google AI Studio key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenAI Configuration (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Anthropic Configuration (optional alternative, chat only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Vector dimensions -- MUST match sql/init_supabase.sql's VECTOR(...) column.
# 768 = gemini-embedding-001 (default). If you switch EMBEDDING_PROVIDER to
# "openai", change this to 1536 and re-run sql/init_supabase.sql before
# re-seeding, or old rows will have mismatched dimensions.
EMBEDDING_DIMENSIONS=768

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
